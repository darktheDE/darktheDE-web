# Copy to .env.local and fill in. .env.local is gitignored.

# ─── Supabase ────────────────────────────────────────────────
# How to find these:
# 1. Go to https://supabase.com/dashboard → select your project
# 2. Click the gear icon (Project Settings) → API (left sidebar)
# 3. Under "Configuration" you'll find:
#    - Project URL           → paste into NEXT_PUBLIC_SUPABASE_URL
#    - Publishable key (anon) → paste into NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
# The publishable key starts with "eyJ..." (a long JWT string).
# It used to be called "anon key" — same value, renamed in 2026.
NEXT_PUBLIC_SUPABASE_URL=                  # e.g. https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # starts with "eyJ..."

# ─── Cloudinary ──────────────────────────────────────────────
# How to find these:
# 1. Go to https://cloudinary.com/console → Dashboard
# 2. Under "Product Environment" you'll see Cloud name, API Key, API Secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=      # unsigned preset for browser uploads
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=                     # server-only

# Site URL — used by Supabase Auth for email-link redirects
# Production: https://darkthede.github.io
# Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000