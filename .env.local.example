# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                # server-only, never expose to browser

# Cloudinary (https://cloudinary.com/console)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=     # unsigned preset for browser uploads
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=                    # server-only

# Site URL — used by Supabase Auth for email-link redirects
# Production: https://darkthede.github.io
# Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000